{
  "profile_id": "ja_se_technical_writing_v1",
  "profile_version": "1.0.0",
  "language": "ja-JP",
  "status": "default_candidate_profile",
  "references": [
    "09_REFERENCE_BASIS.md",
    "10_JAPANESE_TECHNICAL_WRITING_STANDARD.md",
    "12_RULE_SOURCE_TRACEABILITY.csv"
  ],
  "priority_order": [
    "user_confirmed_override",
    "applicable_law_contract_customer_standard",
    "safety_and_factuality",
    "semantic_consistency",
    "this_profile",
    "general_readability"
