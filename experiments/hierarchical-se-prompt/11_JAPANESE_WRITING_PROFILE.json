  "auto_fix_policy": {
    "allowed": [
      "punctuation_width_spacing",
      "canonical_term_substitution_when_unambiguous",
      "typo_and_reference_typo",
      "sentence_split_without_semantic_change"
    ],
    "human_confirmation_required": [
      "numeric_change",
      "threshold_or_tolerance_change",
      "subject_or_responsibility_change",
      "and_or_selection",
      "normative_level_change",
      "architecture_selection",
      "safety_regulatory_semantic_change"
    ]
  },
