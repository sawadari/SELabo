  "document_language": {
    "use_plain_japanese": true,
    "explicit_subject": true,
    "arabic_numerals": true,
    "japanese_punctuation": true,
    "avoid_unnecessary_abbreviations": true,
    "preserve_official_product_and_standard_names": true
  },
  "normative_style": {
    "default": "controlled_declarative",
    "supported": [
      "controlled_declarative",
      "strict_normative"
    ],
    "controlled_declarative": {
      "mandatory": "〜する。",
      "prohibition": "〜してはならない。",
      "recommendation": "〜することが望ましい。",
      "permission": "〜してもよい。",
      "capability": "〜することができる。",
      "mandatory_metadata_required": true
    },
    "strict_normative": {
      "mandatory": "〜しなければならない。",
      "prohibition": "〜してはならない。",
      "recommendation": "〜することが望ましい。",
      "permission": "〜してもよい。",
      "capability": "〜することができる。"
    }
  },
  "naming": {
    "stakeholder_need": "〈利害関係者〉は、〈目的または利用状況〉のために、〈達成したい結果〉したい。",
