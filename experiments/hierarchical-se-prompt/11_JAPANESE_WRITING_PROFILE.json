  "quality_checks": [
    {
      "id": "JA-NAM-01",
      "severity": "medium",
      "rule": "機能・アクション名が対象を明示した動詞句である"
    },
    {
      "id": "JA-NAM-02",
      "severity": "high",
      "rule": "ユースケース名がアクターの観測可能な目標を表す"
    },
    {
      "id": "JA-NAM-03",
      "severity": "high",
      "rule": "状態と事象を混同しない"
    },
    {
      "id": "JA-NAM-04",
      "severity": "medium",
      "rule": "構造・信号・交換項目が名詞句である"
    },
    {
      "id": "JA-NAM-05",
      "severity": "high",
      "rule": "正規名称が全投影で一致する"
    },
    {
      "id": "JA-REQ-01",
      "severity": "critical",
      "rule": "要求主体が明示される"
    },
    {
      "id": "JA-REQ-02",
      "severity": "high",
      "rule": "原則として1要求1義務である"
    },
    {
      "id": "JA-REQ-03",
      "severity": "high",
      "rule": "条件・トリガー・状態・例外が明示される"
