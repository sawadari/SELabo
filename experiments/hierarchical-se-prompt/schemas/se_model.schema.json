{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/se_model.schema.json",
  "title": "Hierarchical Systems Engineering Candidate Model",
  "description": "Schema for the normalized candidate semantic source of truth generated by the one-shot hierarchical SE prompt.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "meta",
    "source_fragments",
    "scope",
    "glossary",
    "stakeholders",
    "concerns",
    "needs",
    "measures",
    "use_cases",
    "scenarios",
    "requirements",
    "behaviors",
    "structures",
    "interfaces",
    "constraints",
    "allocations",
    "verification_cases",
    "validation_cases",
    "risks",
    "hazards",
    "failure_modes",
    "assumptions",
    "alternatives",
    "decisions",
    "relations",
    "findings",
    "quality_summary"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "artifact_type",
        "schema_version",
        "target_system",
        "target_maturity",
        "sysml_version_target",
        "source_of_truth_status"
      ],
      "properties": {
        "artifact_type": {
          "const": "hierarchical_se_model_candidate"
        },
        "schema_version": {
          "type": "string"
        },
        "target_system": {
          "type": "string",
          "minLength": 1
        },
        "target_maturity": {
          "type": "string"
        },
        "sysml_version_target": {
          "type": "string"
        },
        "source_of_truth_status": {
          "const": "candidate_semantic_source_of_truth"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source_fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceFragment"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryTerm"
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stakeholder"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseElement"
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseElement"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/structure"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseElement"
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "verification_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationCase"
      }
    },
    "validation_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationCase"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseElement"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failureMode"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "quality_summary": {
      "type": "object",
      "required": [
        "overall_result",
        "checks"
      ],
      "properties": {
        "overall_result": {
          "$ref": "#/$defs/checkResult"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualityCheck"
          }
        },
        "not_performed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "language_quality": {
      "type": "object",
      "description": "日本語技術文章プロファイルの適用状態と検査結果",
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "requirement_modal_style": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        },
        "finding_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{4,}$"
    },
    "level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "cross_level",
        "unknown"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "user_explicit",
        "user_confirmed",
        "assistant_prior_unconfirmed",
        "ai_context_inference",
        "ai_generic_seed",
        "external_candidate"
      ]
    },
    "claimState": {
      "type": "string",
      "enum": [
        "stated",
        "inferred",
        "assumed"
      ]
    },
    "decisionState": {
      "type": "string",
      "enum": [
        "not_decided",
        "proposed",
        "selected_provisional",
        "user_confirmed",
        "rejected",
        "deferred"
      ]
    },
    "validityState": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "superseded"
      ]
    },
    "baselineState": {
      "type": "string",
      "enum": [
        "outside_baseline",
        "proposed_for_baseline",
        "baselined"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "checkResult": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_provisional_assumption",
        "fail",
        "not_applicable",
        "not_performed"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "baseElement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "level",
        "origin",
        "claim_state",
        "decision_state",
        "validity_state",
        "baseline_state",
        "confidence",
        "evidence_refs",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "product_layer": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstraction": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "claim_state": {
          "$ref": "#/$defs/claimState"
        },
        "decision_state": {
          "$ref": "#/$defs/decisionState"
        },
        "validity_state": {
          "$ref": "#/$defs/validityState"
        },
        "baseline_state": {
          "$ref": "#/$defs/baselineState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "rationale": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "sourceFragment": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "content_summary",
        "in_scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "origin": {
          "type": "string",
          "enum": [
            "user_explicit",
            "user_confirmed",
            "assistant_prior_unconfirmed",
            "external_candidate",
            "meta_instruction",
            "out_of_scope"
          ]
        },
        "content_summary": {
          "type": "string"
        },
        "verbatim_excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_scope": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "target_system",
        "purpose",
        "included",
        "excluded",
        "external_systems",
        "operational_environment",
        "assumption_refs"
      ],
      "properties": {
        "target_system": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string"
        },
        "problem_or_opportunity": {
          "type": [
            "string",
            "null"
          ]
        },
        "included": {
          "$ref": "#/$defs/stringArray"
        },
        "excluded": {
          "$ref": "#/$defs/stringArray"
        },
        "external_systems": {
          "$ref": "#/$defs/stringArray"
        },
        "operational_environment": {
          "$ref": "#/$defs/stringArray"
        },
        "lifecycle_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "success_measure_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "assumption_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "scope_alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "glossaryTerm": {
      "type": "object",
      "required": [
        "term",
        "definition",
        "origin"
      ],
      "properties": {
        "term": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "additionalProperties": true
    },
    "stakeholder": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "category",
            "applicability",
            "concern_refs",
            "need_refs"
          ],
          "properties": {
            "category": {
              "type": "string"
            },
            "applicability": {
              "type": "string",
              "enum": [
                "applicable",
                "uncertain",
                "not_applicable"
              ]
            },
            "applicability_rationale": {
              "type": "string"
            },
            "concern_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "need_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "responsibilities": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "need": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "statement",
            "stakeholder_refs",
            "concern_refs",
            "expected_value",
            "success_measure_refs",
            "validation_case_refs"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "stakeholder_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "concern_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "expected_value": {
              "type": "string"
            },
            "undesired_outcomes": {
              "$ref": "#/$defs/stringArray"
            },
            "success_measure_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "validation_case_refs": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "measure": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "measure_type",
            "observable"
          ],
          "properties": {
            "measure_type": {
              "type": "string",
              "enum": [
                "effectiveness",
                "performance",
                "technical_performance",
                "quality",
                "business_value",
                "other"
              ]
            },
            "observable": {
              "type": "string"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_or_range": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "measurement_context": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "scenario": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "scenario_type",
            "preconditions",
            "trigger",
            "main_flow",
            "alternative_flows",
            "abnormal_flows",
            "recovery",
            "postconditions"
          ],
          "properties": {
            "scenario_type": {
              "type": "string",
              "enum": [
                "normal",
                "alternative",
                "abnormal",
                "shutdown",
                "recovery",
                "maintenance",
                "transition",
                "retirement",
                "other"
              ]
            },
            "actor_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "preconditions": {
              "$ref": "#/$defs/stringArray"
            },
            "trigger": {
              "type": [
                "string",
                "null"
              ]
            },
            "main_flow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alternative_flows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "abnormal_flows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "recovery": {
              "$ref": "#/$defs/stringArray"
            },
            "postconditions": {
              "$ref": "#/$defs/stringArray"
            },
            "observable_results": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "requirement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "statement",
            "requirement_type",
            "normative_level",
            "subject",
            "condition",
            "trigger",
            "required_response_or_property",
            "rationale",
            "source_need_refs",
            "parent_requirement_refs",
            "derivation_basis",
            "allocation_candidate_refs",
            "verification_method_candidate",
            "verification_case_refs",
            "acceptance_criteria_candidate"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "requirement_type": {
              "type": "string",
              "enum": [
                "system_requirement",
                "element_requirement",
                "interface_requirement",
                "constraint_requirement",
                "quality_requirement",
                "operational_requirement",
                "support_requirement",
                "verification_requirement",
                "regulatory_candidate"
              ]
            },
            "normative_level": {
              "type": "string",
              "enum": [
                "mandatory",
                "prohibition",
                "recommendation",
                "permission",
                "descriptive"
              ]
            },
            "subject": {
              "type": "string"
            },
            "condition": {
              "type": [
                "string",
                "null"
              ]
            },
            "trigger": {
              "type": [
                "string",
                "null"
              ]
            },
            "required_response_or_property": {
              "type": "string"
            },
            "object": {
              "type": [
                "string",
                "null"
              ]
            },
            "performance_or_limit": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "tolerance": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "source_need_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "parent_requirement_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "derivation_basis": {
              "type": "string"
            },
            "allocation_candidate_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "verification_method_candidate": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification_case_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "acceptance_criteria_candidate": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "behavior": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "behavior_type",
            "input_refs",
            "output_refs",
            "preconditions",
            "postconditions",
            "performer_candidate_refs",
            "requirement_refs"
          ],
          "properties": {
            "behavior_type": {
              "type": "string",
              "enum": [
                "function",
                "activity",
                "interaction",
                "state_transition",
                "operation",
                "procedure",
                "other"
              ]
            },
            "input_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "output_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "preconditions": {
              "$ref": "#/$defs/stringArray"
            },
            "postconditions": {
              "$ref": "#/$defs/stringArray"
            },
            "performer_candidate_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "requirement_refs": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "structure": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "structure_kind",
            "logical_or_physical",
            "part_refs",
            "requirement_refs",
            "behavior_refs",
            "interface_refs"
          ],
          "properties": {
            "structure_kind": {
              "type": "string"
            },
            "logical_or_physical": {
              "type": "string",
              "enum": [
                "logical",
                "physical",
                "mixed",
                "implementation"
              ]
            },
            "system_element_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "owner_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "part_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "requirement_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "behavior_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "interface_refs": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "interface": {
      "allOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "type": "object",
          "required": [
            "source_element_ref",
            "target_element_ref",
            "boundary",
            "exchanged_item",
            "flow_kind",
            "direction",
            "normal_behavior",
            "failure_behavior",
            "requirement_refs",
            "verification_refs"
          ],
          "properties": {
            "source_element_ref": {
              "type": "string"
            },
            "target_element_ref": {
              "type": "string"
            },
            "boundary": {
              "type": "string"
            },
            "exchanged_item": {
              "type": "string"
            },
            "flow_kind": {
              "type": "string",
              "enum": [
                "information",
                "signal",
                "material",
                "energy",
                "control",
                "mechanical",
                "human_interaction",
                "responsibility"
              ]
            },
            "direction": {
              "type": "string"
            },
            "type_or_format": {
              "type": [
                "string",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "range_or_capacity": {
              "type": [
                "string",
                "number",
                "null"
